# Variables de entorno y contraseñas
.env

# Entorno virtual de Python
.venv/
venv/
env/

# Archivos temporales de Python
__pycache__/
*.py[cod]
*$py.class

# Cachés de herramientas Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/

# Copias de bases de datos
backup/*
backups/*
*.backup
*.dump
*.dmp
*.tar

# Nombres específicos de los respaldos OLTP
bd-OLTP
bd_OLTP

# Archivos temporales de Power BI y Office
~$*.pbix
~$*.xlsx
~$*.docx

# Configuración local de editores
.vscode/
.idea/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini